<div class="staff-dashboard">
  {{! ── Stats Grid ── }}
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-icon stat-icon-orders">📦</div>
      <div class="stat-body">
        <p class="stat-value">{{stats.totalOrders}}</p>
        <p class="stat-label">Total Orders</p>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon stat-icon-revenue">💰</div>
      <div class="stat-body">
        <p class="stat-value">${{stats.totalRevenue}}</p>
        <p class="stat-label">Total Revenue</p>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon stat-icon-customers">👥</div>
      <div class="stat-body">
        <p class="stat-value">{{stats.totalCustomers}}</p>
        <p class="stat-label">Customers</p>
      </div>
    </div>
    <div class="stat-card">
      <div class="stat-icon stat-icon-products">🏷️</div>
      <div class="stat-body">
        <p class="stat-value">{{stats.totalProducts}}</p>
        <p class="stat-label">Products</p>
      </div>
    </div>
  </div>

  {{! ── Alerts ── }}
  {{#if success}}
  <div class="alert alert-success">{{#if (eq success 'added')}}Product added successfully.{{/if}}{{#if (eq success 'edited')}}Product updated successfully.{{/if}}{{#if (eq success 'deleted')}}Product deleted successfully.{{/if}}</div>
  {{/if}}
  {{#if error}}
  <div class="alert alert-error">{{#if (eq error '1')}}Please fill in all required fields.{{/if}}{{#if (eq error 'notfound')}}Product not found.{{/if}}{{error}}</div>
  {{/if}}

  {{! ── Products Section ── }}
  <div class="orders-section">
    <div class="section-header">
      <h2 class="section-title">Product Catalog</h2>
      <div class="section-header-actions">
        <span class="section-count">{{products.length}} products</span>
        <a href="/staff/products/add" class="btn-add-entity">+ Add Product</a>
      </div>
    </div>

    <div class="staff-orders-table-wrap">
      <table class="staff-orders-table">
        <thead>
          <tr>
            <th>Image</th>
            <th>Name</th>
            <th>Category</th>
            <th>Type</th>
            <th>Price</th>
            <th>Badge</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {{#each products}}
          <tr class="order-row">
            <td>
              <img src="{{image}}" alt="{{name}}" class="staff-product-img" loading="lazy">
            </td>
            <td class="product-name-cell">{{name}}</td>
            <td>{{category}}</td>
            <td>{{type}}</td>
            <td class="order-total-cell">${{price}}</td>
            <td>
              {{#if badge}}
              <span class="badge {{badgeClass badge}}">{{badge}}</span>
              {{else}}
              <span class="muted">—</span>
              {{/if}}
            </td>
            <td>
              <div class="action-btns">
                <a href="/staff/products/edit/{{id}}" class="btn-sm btn-edit">Edit</a>
                <form method="POST" action="/staff/products/delete/{{id}}" onsubmit="return confirm('Delete {{name}}?')">
                  <button type="submit" class="btn-sm btn-delete">Delete</button>
                </form>
              </div>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</div>
